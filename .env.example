# Copy to .env and fill in. Never commit the real .env file.

# Supabase: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (sb_secret_...) or legacy service_role key. Server-side only.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional
PORT=8080
SUPABASE_TABLE=survey_responses
# Submissions allowed per IP address every 10 minutes
RATE_LIMIT=5
# Set to true when running behind a proxy or load balancer (Render, Fly, Nginx)
TRUST_PROXY=false
# Only if the page is hosted on a different domain than this API
ALLOWED_ORIGIN=
